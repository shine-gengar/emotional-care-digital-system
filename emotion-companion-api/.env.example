# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置（Sealos提供）
DATABASE_URL="postgresql://user:password@localhost:5432/emotion_companion?schema=public"

# JWT密钥（自己设置一个随机字符串）
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# SiliconFlow API配置
SILICONFLOW_API_KEY="sk-your-siliconflow-api-key-here"

# 可选：TTS配置（如果需要语音功能）
# SILICONFLOW_TTS_API_KEY=""
